{
  "name": "forest-talk-api",
  "version": "1.0.0",
  "description": "API do Forest Talk (Express, Sequelize, PostgreSQL, Zod). Serve o que o app Flutter pede.",
  "main": "app.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "test": "NODE_ENV=test node --test --test-concurrency=1 \"src/**/*.test.js\"",
    "smoke:test": "node scripts/smoke-test.js",
    "check:size": "node scripts/check-file-size.js",
    "start:prod": "sequelize-cli db:migrate && node app.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  }
}
