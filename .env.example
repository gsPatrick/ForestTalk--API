# Ambiente
NODE_ENV=development
PORT=3333
API_PREFIX=/api
LOG_LEVEL=info
CORS_ORIGINS=*

# Banco (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forest_talk
# Em produção o SSL é exigido; coloque false se o banco não tiver SSL (sslmode=disable).
DATABASE_SSL=true

# Segurança
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=365d

# Conteúdo dos jogos (JSON). No servidor use a cópia versionada em ./content.
CONTENT_DIR=./content

# Assinatura (RevenueCat). Sem chave, funciona em modo de teste.
SUBSCRIPTION_TEST_MODE=true
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTH=

# IA (sem chave, a conversa usa respostas de teste)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
CHAT_DAILY_LIMIT=60
